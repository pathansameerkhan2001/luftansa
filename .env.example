# Copy to .env.local and fill in. Never commit .env.local.
# These are SERVER-ONLY variables. Never prefix AWS values with NEXT_PUBLIC_.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-2
AWS_S3_BUCKET=luftansa-store-assets

# Optional: base URL of a CloudFront distribution in front of the private bucket
# (using Origin Access Control), e.g. https://dxxxxxxxxxxxx.cloudfront.net
# When empty, assets are served through the app's /media/<key> route.
ASSET_CDN_URL=

# ---------------------------------------------------------------------------
# Admin authentication: Amazon Cognito (Authorization Code + PKCE, public client)
# All server-only. Never prefix with NEXT_PUBLIC_. There is NO client secret.
# ---------------------------------------------------------------------------
COGNITO_REGION=ap-south-2
COGNITO_USER_POOL_ID=ap-south-2_xxxxxxxxx
COGNITO_CLIENT_ID=your-app-client-id
# Managed Login domain (no trailing slash)
COGNITO_DOMAIN=https://your-prefix.auth.ap-south-2.amazoncognito.com
# Must exactly match an Allowed callback URL / sign-out URL in the app client
AUTH_REDIRECT_URI=https://your-site.example/api/auth/callback
AUTH_LOGOUT_REDIRECT_URI=https://your-site.example/
# Comma-separated administrator emails allowed into /admin (must be verified in Cognito)
ADMIN_EMAILS=admin@example.com
# Random secret (>= 32 chars) used to encrypt auth cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Optional: admin session length in seconds (default 43200 = 12 hours)
AUTH_SESSION_MAX_AGE=43200
